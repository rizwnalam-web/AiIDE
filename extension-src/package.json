{
  "name": "nexus-ai",
  "displayName": "Nexus AI",
  "description": "Next-gen AI assistant for VS Code",
  "version": "1.0.0",
  "publisher": "pixel-studio",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Machine Learning"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nexus-ai.chat",
        "title": "Nexus AI: Open Chat"
      },
      {
        "command": "nexus-ai.generateSQL",
        "title": "Nexus AI: Generate PL/SQL"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nexus-ai-explorer",
          "title": "Nexus AI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "nexus-ai-explorer": [
        {
          "type": "webview",
          "id": "nexus-ai.chatView",
          "name": "Nexus Chat"
        }
      ]
    },
    "configuration": {
      "title": "Nexus AI",
      "properties": {
        "nexus-ai.apiKey": {
          "type": "string",
          "default": "",
          "description": "Your AI Provider API Key"
        },
        "nexus-ai.provider": {
          "type": "string",
          "enum": ["openai", "anthropic", "google", "ollama"],
          "default": "google",
          "description": "AI Model Provider"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^16.11.7",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "openai": "^4.0.0",
    "ollama": "^0.5.0"
  }
}
